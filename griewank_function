%% Griewank Function

xmin = -5;
xmax =  5;

%% Training data

trainadim = 0.3;
xTrain = xmin:trainadim:xmax;

[X, Y] = meshgrid(xTrain, xTrain);
[satir, sutun] = size(X);

N = satir * sutun;

Zd = zeros(satir, sutun);
Zdornek = zeros(N, 1);
Xornek = zeros(N, 2);

say = 1;

for j = 1:satir
    for k = 1:sutun

        Xornek(say, :) = [X(j,k), Y(j,k)];

        Zd(j,k) = (X(j,k)^2 + Y(j,k)^2) / 4000 ...
                  - cos(X(j,k)) * cos(Y(j,k) / sqrt(2)) ...
                  + 1;

        Zdornek(say) = Zd(j,k);

        say = say + 1;
    end
end

%% Testing data

testadim = 0.4;
xTest = xmin:testadim:xmax;

[Xt, Yt] = meshgrid(xTest, xTest);
[satirt, sutunt] = size(Xt);

Nt = satirt * sutunt;

Zdtest = zeros(satirt, sutunt);
Zdornektest = zeros(Nt, 1);
Xornektest = zeros(Nt, 2);

sayt = 1;

for j = 1:satirt
    for k = 1:sutunt

        Xornektest(sayt, :) = [Xt(j,k), Yt(j,k)];

        Zdtest(j,k) = (Xt(j,k)^2 + Yt(j,k)^2) / 4000 ...
                      - cos(Xt(j,k)) ...
                      * cos(Yt(j,k) / sqrt(2)) ...
                      + 1;

        Zdornektest(sayt) = Zdtest(j,k);

        sayt = sayt + 1;
    end
end

%% Dataset information

fprintf('Number of training samples: %d\n', N);
fprintf('Number of testing samples : %d\n', Nt);
